model AboutCard {
  id          String    @id // "pillar-1", "pillar-2", "pillar-3"
  number      String    // "01", "02", "03"
  title       String
  description String    @db.Text
  color       String    @default("blue") // "blue", "yellow", "purple"
  order       Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt   DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt   DateTime?
}

model SiteContent {
  id        String    @id @default(cuid())
  section   String    // "hero", "about", etc.
  key       String    // "title", "subtitle", etc.
  value     String    @db.Text
  updatedBy String?   // Discord user ID
  createdAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt DateTime?

  @@unique([section, key])
}
