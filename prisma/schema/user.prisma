enum Role {
  GUEST
  MEMBER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String    @id @default(cuid())
  discordId      String    @unique
  username       String?
  displayName    String?
  nickname       String?
  customNickname String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  customAvatar   String?
  banner         String?
  bio            String?   @db.Text
  isInGuild      Boolean   @default(false)
  guildRoles     String[]  @default([])
  role           Role      @default(GUEST)
  lastLoginAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  createdAt      DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt      DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt      DateTime?

  accounts       Account[]
  sessions       Session[]
  activityLogs   ActivityLog[]
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  createdAt         DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt         DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  createdAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime
  createdAt  DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt  DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt  DateTime?

  @@unique([identifier, token])
}

model ActivityLog {
  id        String    @id @default(cuid())
  userId    String?
  action    String    // "USER_LOGIN", "USER_LOGOUT", "UPDATE_HERO", etc.
  details   String?   @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
