enum Role {
  GUEST
  MEMBER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String    @id @default(cuid())
  discordId      String    @unique
  username       String?
  displayName    String?
  nickname       String?
  customNickname String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  customAvatar   String?
  banner         String?
  bio            String?   @db.Text
  isInGuild      Boolean   @default(false)
  guildRoles     String[]  @default([])
  role           Role      @default(GUEST)
  lastLoginAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  createdAt      DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt      DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt      DateTime?

  accounts       Account[]
  sessions       Session[]
  adminLogs      AdminLog[]
  memberLogs     MemberLog[]

  @@index([role])
  @@index([discordId])
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  createdAt         DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt         DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  createdAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt    DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id        String    @id @default(cuid())
  userId    String?
  action    String    // e.g. "ADMIN_LOGIN_SUCCESS", "ADMIN_LOGIN_FAILED", "ADMIN_LOGOUT", "UPLOAD_GALLERY_IMAGE", "UPDATE_HERO", etc.
  details   String?   @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model MemberLog {
  id        String    @id @default(cuid())
  userId    String?
  action    String    // e.g. "MEMBER_LOGIN", "MEMBER_LOGOUT", "INTERACTION_CLICK", "CLICK_EXTERNAL_LINK", "PAGE_VIEW", etc.
  details   String?   @db.Text
  targetUrl String?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')"))
  updatedAt DateTime  @default(dbgenerated("(now() + INTERVAL '7 hours')")) @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model AdminRateLimit {
  userId      String    @id       // Discord User ID dari session
  count       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
